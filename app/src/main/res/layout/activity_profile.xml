<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8FA">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Profil Saya"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#66536E"
                android:gravity="center"
                android:layout_marginBottom="25dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="22dp"
                android:background="#F1E8F5">

                <ImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="115dp"
                    android:layout_height="115dp"
                    android:src="@drawable/banner_kucing"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_profile_circle"
                    android:clipToOutline="true"
                    android:contentDescription="Foto profil"/>

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengguna PawCare"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:textColor="#66536E"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="petlover@email.com"
                    android:textSize="13sp"
                    android:textColor="#887B91"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pengaturan Akun"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#66536E"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/btnEditProfile"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="👤   Edit Profil"
                android:textSize="15sp"
                android:textColor="#66536E"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:background="#F1E8F5"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="🔔   Notifikasi"
                android:textSize="15sp"
                android:textColor="#66536E"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginTop="10dp"
                android:background="#F1E8F5"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="⚙️   Pengaturan"
                android:textSize="15sp"
                android:textColor="#66536E"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginTop="10dp"
                android:background="#F1E8F5"/>

            <TextView
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:text="🚪   Keluar"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#D16D83"
                android:gravity="center_vertical"
                android:padding="16dp"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="15dp"
                android:background="#F8E5EB"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#E9DDF2">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⌂&#10;Beranda"
            android:textColor="#66536E"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/navArticle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="▤&#10;Artikel"
            android:textColor="#66536E"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="♙&#10;Profil"
            android:textColor="#A88BC1"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>
