<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@drawable/latar_blakang">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🐾"
        android:textSize="65sp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selamat Datang di PawCare"
        android:textSize="25sp"
        android:textStyle="bold"
        android:textColor="#66536E"
        android:layout_marginTop="12dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rawat kucing kesayanganmu"
        android:textColor="#66536E"
        android:textSize="14sp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="30dp"/>

    <EditText
        android:id="@+id/etEmail"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:hint="Alamat Email"
        android:padding="14dp"
        android:singleLine="true"
        android:inputType="textEmailAddress"
        android:backgroundTint="#D49EAF"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/transparent"
        android:layout_marginTop="15dp">

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:hint="Kata Sandi"
            android:padding="14dp"
            android:singleLine="true"
            android:inputType="textPassword"
            android:backgroundTint="#D49EAF"/>

        <TextView
            android:id="@+id/btnTogglePassword"
            android:layout_width="65dp"
            android:layout_height="match_parent"
            android:text="Lihat"
            android:textColor="#66536E"
            android:textStyle="bold"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="MASUK"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#A88BC1"
        android:layout_marginTop="28dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cinta, Perawatan &amp; Kucing Bahagia ♡"
        android:textColor="#66536E"
        android:textSize="13sp"
        android:layout_marginTop="30dp"/>

</LinearLayout>
